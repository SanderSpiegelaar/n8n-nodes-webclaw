{
  "name": "n8n-nodes-webclaw",
  "version": "0.2.0",
  "description": "n8n community node for scraping, crawling, mapping, summarizing, and extracting website data with Webclaw",
  "keywords": [
    "n8n-community-node-package"
  ],
  "homepage": "https://github.com/sanderspiegelaar/n8n-nodes-webclaw",
  "license": "MIT",
  "author": {
    "name": "Sander Spiegelaar",
    "email": "sanderspiegelaar@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanderspiegelaar/n8n-nodes-webclaw.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "webclaw.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/WebclawApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Webclaw/Webclaw.node.js"
    ]
  }
}
